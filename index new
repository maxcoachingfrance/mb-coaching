<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
<title>MB Coaching — Coach & Préparateur Diplômé</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;0,900;1,900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
  :root{
    --black:#0a0a0a;
    --card:#1c1c1c;
    --red:#ff3a3a;
    --red-dim:rgba(255,58,58,0.35);
    --white:#ffffff;
    --gray:#9a9a9a;
    --grayline:rgba(255,255,255,0.14);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;scroll-padding-top:70px;}
  body{
    background:#e8e8e8;
    color:var(--black);
    font-family:'Barlow',sans-serif;
    line-height:1.5;
    overflow-x:hidden;
  }
  a{color:inherit;}
  .uc{font-family:'Barlow Condensed',sans-serif;text-transform:uppercase;}

  /* MENU BURGER (overlaid directly on hero photo, matching the icon already in the image) */
  .hero-burger{
    position:absolute;top:6.3%;right:5.9%;width:12.5%;aspect-ratio:1/1;
    border-radius:50%;background:#fff;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;border:none;z-index:3;padding:0;
    box-shadow:0 3px 10px rgba(0,0,0,0.25);
  }
  .hero-burger svg{width:52%;height:52%;}

  /* FIXED TOP BAR (stays visible while scrolling) */
  .topbar{
    position:fixed;top:0;left:0;right:0;z-index:50;
    display:flex;align-items:center;justify-content:center;
    height:56px;background:rgba(10,10,10,0.85);
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .topbar-logo{height:26px;width:auto;}
  .topbar-burger{
    position:absolute;top:50%;right:16px;transform:translateY(-50%);
    width:36px;height:36px;border-radius:50%;background:#fff;
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;border:none;padding:0;
    box-shadow:0 2px 6px rgba(0,0,0,0.25);
  }
  .topbar-burger svg{width:52%;height:52%;}

  .menu-overlay{
    position:fixed;inset:0;background:#0a0a0a;z-index:200;
    display:none;flex-direction:column;align-items:center;justify-content:center;gap:28px;
  }
  .menu-overlay.open{display:flex;}
  .menu-overlay a{
    font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.6rem;text-transform:uppercase;
    color:#fff;text-decoration:none;letter-spacing:1px;
  }
  .menu-close{position:absolute;top:20px;right:22px;background:none;border:none;color:#fff;font-size:1.8rem;cursor:pointer;}

  /* HERO */
  .hero{
    position:relative;
    width:100%;
    background:#111 url("data:image/jpeg;base64,") center 30%/cover no-repeat;
    min-height:100vh;
    min-height:100svh;
  }
  .hero::after{
    content:'';position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.05) 55%, rgba(0,0,0,0.65) 100%);
  }
  .hero-content{position:absolute;z-index:2;top:59%;left:0;right:0;padding:0 22px;text-align:center;display:flex;flex-direction:column;align-items:center;}
  .mb-badge{height:3.4rem;width:auto;display:block;margin-bottom:10px;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.4));}
  .hero-title{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.5rem;line-height:1.15;color:#fff;text-transform:uppercase;text-align:center;margin:0;letter-spacing:0.3px;text-shadow:0 2px 10px rgba(0,0,0,0.6);}
  .hero-sub{
    font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;letter-spacing:0.5px;
    color:rgba(255,255,255,0.9);text-transform:uppercase;margin-top:16px;line-height:1.4;text-align:center;text-shadow:0 2px 8px rgba(0,0,0,0.6);
  }

  /* SECTION LABELS */
  .section-title{
    font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.9rem;text-transform:uppercase;
    text-align:center;padding:34px 20px 22px;color:#0a0a0a;
  }

  /* TRANSFORMATIONS */
  .transforms-wrap{background:#e8e8e8;padding-bottom:8px;}
  .transforms-strip{
    display:flex;gap:14px;overflow-x:auto;padding:0 20px 10px;scrollbar-width:none;
  }
  .transforms-strip::-webkit-scrollbar{display:none;}
  .tcard{
    flex:0 0 auto;height:160px;border-radius:14px;border:3px solid #0a0a0a;
    overflow:hidden;background:#fff;position:relative;
  }
  .tcard img{display:block;height:100%;width:auto;}

  /* AVIS */
  .avis-wrap{background:#e8e8e8;padding-bottom:30px;}
  .google-badge{display:flex;flex-direction:column;align-items:center;gap:6px;margin-bottom:22px;}
  .google-badge-row{display:flex;align-items:center;gap:8px;}
  .google-rating-num{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.4rem;color:#0a0a0a;}
  .stars{text-align:center;font-size:1.3rem;color:#fbbc04;letter-spacing:4px;}
  .google-badge-label{font-size:0.75rem;color:#666;}
  .avis-strip{display:flex;gap:16px;overflow-x:auto;padding:0 20px 14px;scrollbar-width:none;}
  .avis-strip::-webkit-scrollbar{display:none;}
  .avis-card{
    flex:0 0 250px;background:#fff;border-radius:16px;
    padding:22px 20px;position:relative;
    box-shadow:0 6px 20px rgba(0,0,0,0.08);
    border-top:4px solid #fff;
  }
  .avis-stars-row{color:#fbbc04;font-size:0.9rem;letter-spacing:2px;margin-bottom:10px;}
  .avis-text{font-size:0.88rem;color:#222;line-height:1.55;margin-bottom:16px;}
  .avis-name{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:0.85rem;text-transform:uppercase;color:#0a0a0a;}
  .avis-role{font-size:0.72rem;color:#888;}

  /* OFFRES */
  .offres-wrap{background:#0a0a0a;padding:36px 0 44px;}
  .offres-wrap .section-title{color:#fff;padding-top:0;padding-left:20px;padding-right:20px;}
  .offer-filter{padding:0 20px 18px;}
  .offer-filter-select{
    width:100%;background:#0d0d0d;border:1.5px solid rgba(255,255,255,0.25);color:#fff;
    font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.95rem;text-transform:uppercase;
    letter-spacing:0.3px;padding:12px 16px;border-radius:12px;cursor:pointer;
    -webkit-appearance:none;appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat:no-repeat;background-position:right 16px center;background-size:16px;
  }
  .offer-filter-select:focus{outline:none;border-color:var(--red);}
  .offer-empty-msg{display:none;color:rgba(255,255,255,0.55);font-size:0.9rem;padding:0 20px 20px;text-align:center;}
  .offres-strip{display:flex;gap:16px;overflow-x:auto;padding:0 20px 14px;scrollbar-width:none;}
  .offres-strip::-webkit-scrollbar{display:none;}
  .offer-card{
    flex:0 0 260px;border-radius:22px;padding:2.5px;
    background:linear-gradient(135deg,var(--red),#ff8a8a,var(--red));
    box-shadow:0 0 24px rgba(255,58,58,0.35);
  }
  .offer-inner{background:#0d0d0d;border-radius:20px;padding:26px 22px;height:100%;display:flex;flex-direction:column;}
  .offer-title{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.4rem;color:#fff;text-transform:uppercase;line-height:1.05;}
  .offer-tag{font-size:0.8rem;color:rgba(255,255,255,0.55);margin-top:6px;margin-bottom:16px;}
  .offer-divider{height:1px;background:rgba(255,255,255,0.15);margin-bottom:18px;}
  .offer-price{display:flex;align-items:baseline;gap:6px;margin-bottom:18px;}
  .offer-price .amt{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:2.2rem;color:var(--red);}
  .offer-price .unit{font-size:0.85rem;color:rgba(255,255,255,0.6);}
  .offer-list{display:flex;flex-direction:column;gap:12px;margin-bottom:22px;flex-grow:1;}
  .sap-notice{
    max-width:520px;margin:0 auto 24px;padding:0 24px;text-align:center;
  }
  .sap-notice b{color:#fff;}
  .sap-notice-head{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:10px;}
  .sap-notice-title{
    font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:0.8rem;
    text-transform:uppercase;color:#fff;margin:0;letter-spacing:0.2px;white-space:nowrap;
  }
  .sap-notice-text{font-size:0.8rem;color:rgba(255,255,255,0.75);line-height:1.5;margin:0;}
  .sap-badge{height:24px;width:auto;vertical-align:-7px;margin-right:6px;}
  .sap-badge-lg{height:38px;width:auto;flex-shrink:0;}
  .offer-packs{border:1px solid rgba(255,255,255,0.12);border-radius:12px;overflow:hidden;margin-bottom:16px;}
  .offer-pack{
    display:flex;align-items:center;justify-content:space-between;
    padding:10px 12px;
  }
  .offer-pack:not(:last-child){border-bottom:1px solid rgba(255,255,255,0.08);}
  .offer-pack-name{font-size:0.8rem;color:#fff;font-weight:600;}
  .offer-pack-price{display:flex;align-items:baseline;gap:5px;}
  .offer-pack-old{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:0.85rem;color:rgba(255,255,255,0.4);text-decoration:line-through;}
  .offer-pack-new{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.1rem;color:var(--red);}
  .offer-pack-unit{font-size:0.66rem;color:rgba(255,255,255,0.5);}
  .offer-from-label{font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;color:rgba(255,255,255,0.55);margin:0 0 3px;}
  .offer-badge-best{
    background:var(--red);color:#fff;text-align:center;font-family:'Barlow Condensed',sans-serif;
    font-weight:900;font-size:0.75rem;letter-spacing:1.2px;text-transform:uppercase;
    padding:7px 0;margin:-26px -22px 18px -22px;border-radius:18px 18px 0 0;
  }
  .offer-sap-box{background:rgba(255,255,255,0.05);border:1px solid rgba(255,58,58,0.35);border-radius:10px;padding:9px 11px;margin-bottom:16px;}
  .offer-sap-prices{display:flex;align-items:baseline;gap:8px;margin-bottom:5px;}
  .offer-sap-old{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1.05rem;color:rgba(255,255,255,0.4);text-decoration:line-through;}
  .offer-sap-new{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.35rem;color:var(--red);}
  .offer-sap-unit{font-size:0.72rem;color:rgba(255,255,255,0.55);}
  .offer-sap-caption{display:flex;align-items:center;font-size:0.66rem;color:rgba(255,255,255,0.65);line-height:1.3;}
  .offer-sap-caption img{height:20px;width:auto;margin-right:5px;flex-shrink:0;}
  .offer-item{display:flex;align-items:flex-start;gap:8px;}
  .offer-item .check{color:var(--red);font-weight:900;flex-shrink:0;}
  .offer-item b{color:#fff;}
  .offer-item span{font-size:0.82rem;color:rgba(255,255,255,0.75);}
  .offer-btn{
    display:block;width:100%;background:#fff;color:#0a0a0a;border:none;border-radius:100px;
    font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1rem;letter-spacing:1px;
    text-transform:uppercase;padding:14px;cursor:pointer;
  }

  /* STUDIO & APPLICATION */
  .studio-wrap{background:#e8e8e8;padding:0 0 40px;}
  .studio-wrap .section-title{padding-left:20px;padding-right:20px;padding-bottom:18px;}
  .sa-grid{display:flex;gap:16px;overflow-x:auto;padding:0 20px 14px;scrollbar-width:none;}
  .sa-grid::-webkit-scrollbar{display:none;}
  .sa-card{
    flex:0 0 260px;border-radius:22px;padding:2.5px;
    background:#fff;
    box-shadow:0 0 24px rgba(255,255,255,0.35);
  }
  .sa-card-inner{background:#0d0d0d;border-radius:20px;padding:16px 14px 20px;height:100%;display:flex;flex-direction:column;}
  .sa-card-head{display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:12px;}
  .sa-card-head img{height:1.1rem;width:auto;}
  .sa-card-head p{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.2rem;text-transform:uppercase;color:#fff;margin:0;}
  .sa-carousel{position:relative;width:100%;height:190px;border-radius:14px;overflow:hidden;border:2px solid #fff;background:#1a1a1a;}
  .sa-carousel-track{display:flex;height:100%;width:100%;transition:transform 0.6s ease;}
  .sa-slide{flex:0 0 100%;height:100%;}
  .sa-slide img{width:100%;height:100%;object-fit:cover;display:block;}
  .sa-slide-placeholder{display:flex;align-items:center;justify-content:center;font-size:2.2rem;color:var(--red);}
  .sa-location{
    text-align:center;margin:10px 0 4px;font-family:'Barlow Condensed',sans-serif;
    font-weight:800;font-size:0.78rem;text-transform:uppercase;color:#fff;
  }
  .sa-text{font-size:0.76rem;color:rgba(255,255,255,0.75);line-height:1.45;text-align:center;margin-bottom:0;}
  .sa-text b{color:#fff;}
  .sa-body{flex:1;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;}
  .mb-app-icon{
    display:inline-flex;align-items:center;justify-content:center;
    width:28px;height:28px;border-radius:8px;background:#000;
    border:1px solid rgba(255,255,255,0.18);overflow:hidden;flex-shrink:0;
  }
  .mb-app-icon img{width:100%;height:100%;object-fit:contain;display:block;padding:4px;box-sizing:border-box;}
  .sa-hashtags{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;}
  .sa-hashtag{font-size:0.66rem;font-weight:700;color:var(--red);background:rgba(255,58,58,0.12);border-radius:100px;padding:4px 10px;}

  /* QUI JE SUIS */
  .who-wrap{background:#e8e8e8;padding:40px 24px 44px;text-align:center;}
  .who-avatar{
    width:150px;height:150px;border-radius:50%;overflow:hidden;
    margin:0 auto 24px;
    border:4px solid var(--red);
    box-shadow:0 8px 24px rgba(255,58,58,0.25);
  }
  .who-avatar img{width:100%;height:100%;object-fit:cover;display:block;}
  .who-text{max-width:420px;margin:0 auto;font-size:0.95rem;color:#333;line-height:1.6;}
  .who-text p{margin-bottom:14px;}
  .who-text b{color:#0a0a0a;}

  /* FAQ */
  .faq-wrap{background:#0a0a0a;padding:40px 20px 30px;}
  .faq-wrap .section-title{color:#fff;padding-top:0;}
  .faq-item{border-bottom:1px solid var(--grayline);}
  .faq-q{
    display:flex;justify-content:space-between;align-items:center;gap:14px;
    padding:18px 4px;cursor:pointer;
  }
  .faq-q span.txt{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:1rem;color:#fff;text-transform:uppercase;}
  .faq-q .plus{color:var(--red);font-size:1.3rem;font-weight:700;transition:transform .2s;flex-shrink:0;}
  .faq-item.open .plus{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .faq-item.open .faq-a{max-height:420px;}
  .faq-a p{padding:0 4px 18px;font-size:0.88rem;color:rgba(255,255,255,0.6);line-height:1.5;}

  /* CONTACT */
  .contact-wrap{background:#0a0a0a;padding:20px 24px 40px;text-align:center;}
  .contact-title{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.5rem;color:#fff;text-transform:uppercase;margin-bottom:26px;}
  .contact-buttons{display:flex;flex-direction:column;gap:14px;max-width:320px;margin:0 auto;}
  .contact-btn{
    display:flex;align-items:center;justify-content:center;gap:10px;
    border-radius:100px;padding:16px 24px;
    font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:1.05rem;letter-spacing:0.5px;
    text-transform:uppercase;text-decoration:none;border:none;cursor:pointer;
  }
  .contact-btn.wa{background:#25D366;color:#0a0a0a;}
  .contact-btn.call{background:#fff;color:var(--red);}

  /* CALLBACK MODAL */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:300;
    display:none;align-items:flex-end;justify-content:center;
  }
  .modal-overlay.open{display:flex;}
  .modal-box{
    background:#141414;width:100%;max-width:480px;border-radius:22px 22px 0 0;
    padding:26px 22px 30px;max-height:88vh;overflow-y:auto;
  }
  .modal-title{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.3rem;color:#fff;text-transform:uppercase;margin-bottom:18px;text-align:center;}
  .modal-field{margin-bottom:16px;}
  .modal-field label{display:block;font-size:0.78rem;color:rgba(255,255,255,0.55);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;font-family:'Barlow Condensed',sans-serif;font-weight:700;}
  .modal-field input, .modal-field select{
    width:100%;background:rgba(255,255,255,0.06);border:1.5px solid rgba(255,255,255,0.15);
    border-radius:10px;padding:13px 14px;color:#fff;font-size:0.95rem;font-family:'Barlow',sans-serif;
  }
  .modal-field select{appearance:none;}
  .modal-submit{
    display:block;width:100%;background:var(--red);color:#fff;border:none;border-radius:100px;
    font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.1rem;letter-spacing:0.5px;
    text-transform:uppercase;padding:16px;cursor:pointer;margin-top:6px;
  }
  .modal-cancel{
    display:block;width:100%;text-align:center;background:none;border:none;
    color:rgba(255,255,255,0.4);font-size:0.85rem;padding:12px;cursor:pointer;text-decoration:underline;
  }
  .footer-links{display:flex;justify-content:center;gap:24px;padding:22px 20px 30px;background:#e8e8e8;flex-wrap:wrap;}
  .footer-links a{font-size:0.78rem;color:#555;text-decoration:underline;}
</style>
</head>
<body>

<div class="menu-overlay" id="menu">
  <button class="menu-close" onclick="document.getElementById('menu').classList.remove('open')">✕</button>
  <a href="#transformations" onclick="document.getElementById('menu').classList.remove('open')">Transformations</a>
  <a href="#avis" onclick="document.getElementById('menu').classList.remove('open')">Avis</a>
  <a href="#offres" onclick="document.getElementById('menu').classList.remove('open')">Offres</a>
  <a href="#studio" onclick="document.getElementById('menu').classList.remove('open')">Studio &amp; Application</a>
  <a href="#qui-je-suis" onclick="document.getElementById('menu').classList.remove('open')">Qui je suis</a>
  <a href="#faq" onclick="document.getElementById('menu').classList.remove('open')">FAQ</a>
  <a href="#contact" onclick="document.getElementById('menu').classList.remove('open')">Contact</a>
</div>

<div class="topbar">
  <img class="topbar-logo" src="data:image/png;base64," alt="MB Coaching">
  <button class="topbar-burger" onclick="document.getElementById('menu').classList.add('open')">
    <svg viewBox="0 0 24 24" fill="none"><path d="M3 6h18M3 12h18M3 18h18" stroke="#ff3a3a" stroke-width="2.4" stroke-linecap="round"/></svg>
  </button>
</div>

<!-- HERO -->
<div class="hero">
  <div class="hero-veil"></div>
  <div class="hero-content">
      <img class="mb-badge" src="data:image/png;base64," alt="MB Coaching">
      <p class="hero-title">Coach &amp; Préparateur Diplômé</p>
    <p class="hero-sub">Diplôme Universitaire &amp; Master 2<br>en Ingénierie Haute Performance Sportive</p>
  </div>
</div>

<!-- TRANSFORMATIONS -->
<div class="transforms-wrap" id="transformations">
  <p class="section-title">Nos Transformations</p>
  <div class="transforms-strip">
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 1"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 2"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 3"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 4"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 5"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 6"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 7"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 8"></div>
    <div class="tcard"><img src="data:image/jpeg;base64," alt="Transformation client 9"></div>
  </div>
</div>

<!-- AVIS -->
<div class="avis-wrap" id="avis">
  <p class="section-title" style="padding-top:6px;">Nos Avis</p>

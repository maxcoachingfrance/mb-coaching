<script>
  // Filtre des offres (Studio / Domicile / Préparation physique) via liste déroulante
  function filterOffers(type){
    var emptyMsg = document.getElementById('offerEmptyMsg');
    var cards = document.querySelectorAll('.offer-card');
    var wrap = document.getElementById('offres');
    if (!type){
      cards.forEach(function(card){ card.style.display = 'none'; });
      if (emptyMsg) emptyMsg.style.display = 'flex';
      if (wrap) wrap.classList.add('offres-empty-state');
      return;
    }
    if (emptyMsg) emptyMsg.style.display = 'none';
    if (wrap) wrap.classList.remove('offres-empty-state');
    cards.forEach(function(card){
      var show = card.getAttribute('data-type') === type;
      card.style.display = show ? '' : 'none';
    });
    var strip = document.querySelector('.offres-strip');
    if (strip) strip.scrollLeft = 0;
    var select = document.getElementById('offerFilterSelect');
    if (select) select.classList.remove('attention');
  }
  // Au chargement, aucune offre n'est affichée tant que rien n'est sélectionné
  document.addEventListener('DOMContentLoaded', function(){ filterOffers(''); });

  // Build time slots 09:00 -> 17:30 every 30 minutes
  (function(){
    var select = document.getElementById('cbSlot');
    for (var h = 9; h <= 17; h++){
      [0,30].forEach(function(m){
        var hh = h.toString().padStart(2,'0');
        var mm = m.toString().padStart(2,'0');
        var opt = document.createElement('option');
        opt.value = hh+':'+mm;
        opt.textContent = hh+':'+mm;
        select.appendChild(opt);
      });
    }
  })();

  function closeCallbackModal(){
    document.getElementById('callbackModal').classList.remove('open');
    document.getElementById('cbFormView').style.display = '';
    document.getElementById('cbSuccessView').style.display = 'none';
    document.getElementById('cbName').value = '';
    document.getElementById('cbPhone').value = '';
  }

  function submitCallback(){
    var name = document.getElementById('cbName').value.trim();
    var phone = document.getElementById('cbPhone').value.trim();
    var day = document.getElementById('cbDay').value;
    var slot = document.getElementById('cbSlot').value;
    if(!name || !phone){
      alert('Merci de renseigner ton nom et ton numéro de téléphone.');
      return;
    }
    var payload = {
      access_key: 'c2703742-10ba-457e-a153-719c6eb18375',
      subject: 'Nouvelle demande de rappel - Site MB Coaching',
      from_name: 'Site MB Coaching',
      message: 'Nouvelle demande de rappel.' +
               '\nNom : ' + name +
               '\nTéléphone : ' + phone +
               '\nCréneau souhaité : ' + day + ' à ' + slot
    };
    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    document.getElementById('cbFormView').style.display = 'none';
    document.getElementById('cbSuccessView').style.display = '';
  }
// Carrousel photo automatique (section Studio)
(function(){
  var track = document.querySelector('#studioCarousel .sa-carousel-track');
  if(!track) return;
  var slides = track.children.length;
  if(slides < 2) return;
  var i = 0;
  setInterval(function(){
    i = (i + 1) % slides;
    track.style.transform = 'translateX(-' + (i * 100) + '%)';
  }, 3000);
})();

// Notification par email a chaque visite du site (un seul mail, envoyé a la fin de la visite)
(function(){
  var startTime = Date.now();
  var sectionsSeen = [];
  var clicksLog = [];
  var visitorLocation = 'Localisation en cours...';
  var visitorIP = null;
  var visitCount = null; // nombre de visites de cette même IP (via CountAPI)

  function labelFor(el){
    if(!el) return null;
    var t = (el.innerText || el.textContent || '').trim().replace(/\s+/g,' ').slice(0,40);
    if(t) return t;
    if(el.getAttribute && el.getAttribute('alt')) return el.getAttribute('alt');
    return el.tagName ? el.tagName.toLowerCase() : null;
  }

  document.addEventListener('click', function(e){
    var el = e.target.closest('a, button, .offer-btn, .contact-btn, .tcard, .sa-carousel-track img, .faq-q');
    if(!el) el = e.target;
    var lbl = labelFor(el);
    if(lbl) clicksLog.push(lbl);
  });

  var sectionIds = {
    hero: 'Accueil',
    transformations: 'Transformations',
    avis: 'Avis',
    offres: 'Offres',
    studio: 'Studio & Application',
    faq: 'FAQ',
    contact: 'Contact'
  };
  if('IntersectionObserver' in window){
    Object.keys(sectionIds).forEach(function(id){
      var el = document.getElementById(id) || (id === 'hero' ? document.querySelector('.hero') : null);
      if(!el) return;
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting && sectionsSeen.indexOf(sectionIds[id]) === -1){
            sectionsSeen.push(sectionIds[id]);
          }
        });
      }, {threshold: 0.3});
      obs.observe(el);
    });
  }

  // 1) On récupère la localisation + l'IP du visiteur
  // 2) On incrémente un compteur de visites propre à cette IP (via CountAPI, gratuit, sans backend)
  fetch('https://ipapi.co/json/')
    .then(function(r){ return r.json(); })
    .then(function(data){
      visitorLocation = (data.city || 'Ville inconnue') + ', ' +
                (data.region || 'Région inconnue') + ' (' +
                (data.country_name || 'Pays inconnu') + ')';
      visitorIP = data.ip || null;
      if(!visitorIP) return null;
      var key = visitorIP.replace(/[^a-zA-Z0-9]/g, '-'); // clé URL-safe (ex: 82-64-12-3)
      return fetch('https://api.countapi.xyz/hit/mbcoaching-visites/' + key)
        .then(function(r){ return r.json(); })
        .then(function(res){ visitCount = res && res.value ? res.value : null; })
        .catch(function(){ visitCount = null; });
    })
    .catch(function(){
      visitorLocation = 'Localisation non disponible';
    });

  var emailSent = false;
  function sendVisitEmail(){
    if (emailSent) return;
    emailSent = true;
    var timeSpent = Math.round((Date.now() - startTime) / 1000);

    // Libellé du nombre de visite pour l'objet du mail
    var visitLabel;
    if (visitCount === 1) visitLabel = '1ère visite';
    else if (visitCount) visitLabel = visitCount + 'e visite (déjà venu)';
    else visitLabel = 'Visite';

    var message = 'Quelqu\'un a visité le site MB Coaching.' +
               '\nPage : ' + window.location.href +
               '\nIP : ' + (visitorIP || 'inconnue') +
               '\nNombre de visites de cette IP : ' + (visitCount || 'inconnu') +
               '\nLocalisation : ' + visitorLocation +
               '\nTemps passé sur le site : ' + timeSpent + ' sec' +
               '\nSections consultées : ' + (sectionsSeen.length ? sectionsSeen.join(', ') : 'aucune') +
               '\nClics effectués : ' + (clicksLog.length ? clicksLog.join(' | ') : 'aucun') +
               '\nDate : ' + new Date().toLocaleString('fr-FR');
    var payload = {
      access_key: 'c2703742-10ba-457e-a153-719c6eb18375',
      subject: visitLabel + ' - Site MB Coaching',
      from_name: 'Site MB Coaching',
      message: message
    };
    try {
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload),
        keepalive: true
      });
    } catch (e) {}
  }

  window.addEventListener('pagehide', sendVisitEmail);
  window.addEventListener('beforeunload', sendVisitEmail);
  document.addEventListener('visibilitychange', function(){
    if (document.visibilityState === 'hidden') sendVisitEmail();
  });
})();
</script>


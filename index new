<div class="who-wrap" id="qui-je-suis">
  <p class="section-title" style="padding-top:0;">Qui je suis ?</p>
  <div class="who-avatar"><img src="data:image/jpeg;base64," alt="Max, coach MB Coaching"></div>
  <div class="who-text">
    <p style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:1.3rem;text-transform:uppercase;color:#0a0a0a;margin-bottom:2px;">Max</p>
    <p style="font-size:0.85rem;color:#666;margin-bottom:16px;">Coach · Préparateur Physique Diplômé</p>

// Notification par email a chaque visite du site (un seul mail, envoyé a la fin de la visite)
(function(){
  var startTime = Date.now();
  var sectionsSeen = [];
  var clicksLog = [];
  var visitorLocation = 'Localisation en cours...';
  var visitorIP = null;
  var visitCount = null; // nombre de visites de cette même IP (via CountAPI)

  function labelFor(el){
    if(!el) return null;
    var t = (el.innerText || el.textContent || '').trim().replace(/\s+/g,' ').slice(0,40);
    if(t) return t;
    if(el.getAttribute && el.getAttribute('alt')) return el.getAttribute('alt');
    return el.tagName ? el.tagName.toLowerCase() : null;
  }

  document.addEventListener('click', function(e){
    var el = e.target.closest('a, button, .offer-btn, .contact-btn, .tcard, .sa-carousel-track img, .faq-q');
    if(!el) el = e.target;
    var lbl = labelFor(el);
    if(lbl) clicksLog.push(lbl);
  });

  var sectionIds = {
    hero: 'Accueil',
    transformations: 'Transformations',
    avis: 'Avis',
    offres: 'Offres',
    studio: 'Studio & Application',
    faq: 'FAQ',
    contact: 'Contact'
  };
  if('IntersectionObserver' in window){
    Object.keys(sectionIds).forEach(function(id){
      var el = document.getElementById(id) || (id === 'hero' ? document.querySelector('.hero') : null);
      if(!el) return;
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting && sectionsSeen.indexOf(sectionIds[id]) === -1){
            sectionsSeen.push(sectionIds[id]);
          }
        });
      }, {threshold: 0.3});
      obs.observe(el);
    });
  }

  // 1) On récupère la localisation + l'IP du visiteur
  // 2) On incrémente un compteur de visites propre à cette IP (via CountAPI, gratuit, sans backend)
  fetch('https://ipapi.co/json/')
    .then(function(r){ return r.json(); })
    .then(function(data){
      visitorLocation = (data.city || 'Ville inconnue') + ', ' +
                (data.region || 'Région inconnue') + ' (' +
                (data.country_name || 'Pays inconnu') + ')';
      visitorIP = data.ip || null;
      if(!visitorIP) return null;
      var key = visitorIP.replace(/[^a-zA-Z0-9]/g, '-'); // clé URL-safe (ex: 82-64-12-3)
      return fetch('https://api.countapi.xyz/hit/mbcoaching-visites/' + key)
        .then(function(r){ return r.json(); })
        .then(function(res){ visitCount = res && res.value ? res.value : null; })
        .catch(function(){ visitCount = null; });
    })
    .catch(function(){
      visitorLocation = 'Localisation non disponible';
    });

  var emailSent = false;
  function sendVisitEmail(){
    if (emailSent) return;
    emailSent = true;
    var timeSpent = Math.round((Date.now() - startTime) / 1000);

    // Libellé du nombre de visite pour l'objet du mail
    var visitLabel;
    if (visitCount === 1) visitLabel = '1ère visite';
    else if (visitCount) visitLabel = visitCount + 'e visite (déjà venu)';
    else visitLabel = 'Visite';

    var message = 'Quelqu\'un a visité le site MB Coaching.' +
               '\nPage : ' + window.location.href +
               '\nIP : ' + (visitorIP || 'inconnue') +
               '\nNombre de visites de cette IP : ' + (visitCount || 'inconnu') +
               '\nLocalisation : ' + visitorLocation +
               '\nTemps passé sur le site : ' + timeSpent + ' sec' +
               '\nSections consultées : ' + (sectionsSeen.length ? sectionsSeen.join(', ') : 'aucune') +
               '\nClics effectués : ' + (clicksLog.length ? clicksLog.join(' | ') : 'aucun') +
               '\nDate : ' + new Date().toLocaleString('fr-FR');
    var payload = {
      access_key: 'c2703742-10ba-457e-a153-719c6eb18375',
      subject: visitLabel + ' - Site MB Coaching',
      from_name: 'Site MB Coaching',
      message: message
    };
    try {
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(payload),
        keepalive: true
      });
    } catch (e) {}
  }

  window.addEventListener('pagehide', sendVisitEmail);
  window.addEventListener('beforeunload', sendVisitEmail);
  document.addEventListener('visibilitychange', function(){
    if (document.visibilityState === 'hidden') sendVisitEmail();
  });
})();
</script>

